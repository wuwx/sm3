{
    "name": "wuwx/sm3",
    "description": "SM3 (GB/T 32905) hash in pure PHP",
    "type": "library",
    "keywords": ["sm3", "国密", "hash", "digest"],
    "homepage": "https://github.com/wuwx/sm3",
    "license": "MIT",
    "authors": [
        {
            "name": "wuwx",
            "email": "wuweixin@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "require": {
        "php": "^7.3 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Wuwx\\Sm3\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wuwx\\Sm3\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    }
}
